[BaseText]
X=(16*#Scale#)
W=((#PanelWidth#-32)*#Scale#)
H=(22*#Scale#)
FontFace=#UIFont#
FontSize=(10.5*#Scale#)
FontColor=#Text#
AntiAlias=1
ClipString=1
DynamicVariables=1

[SecondaryText]
X=(16*#Scale#)
W=((#PanelWidth#-32)*#Scale#)
H=(22*#Scale#)
FontFace=#SecondaryFont#
FontSize=(9.375*#Scale#)
FontColor=#Muted#
AntiAlias=1
ClipString=1
DynamicVariables=1

[NumericText]
X=((#PanelWidth#-16)*#Scale#)
W=((#PanelWidth#-110)*#Scale#)
H=(30*#Scale#)
FontFace=#MetricFont#
FontSize=(16.5*#Scale#)
FontColor=#Text#
AntiAlias=1
ClipString=1
DynamicVariables=1
StringAlign=Right
