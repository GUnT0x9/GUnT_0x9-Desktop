# Local tools, installers, runtime data and recovery snapshots
/apps/
/backups/
/bin/
/downloads/
/logs/
/state/
/diagnostics/
/screenshots/
/tests/
/.codegraph/
/.omo/
*.previous
*.tmp
*.log
*.pdb
**/obj/
**/__pycache__/
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.user
*.suo
# Machine-specific runtime paths, monitor identities, sensor mappings
/config/apps.json
/config/runtime.json
/config/layout.json
/config/dock-layout.json
/config/monitor.json
/config/sensors.json
/config/wallpaper.json
# Generated installed-mod snapshot and deployment logs
/windhawk/mods.json
/windhawk/*.deployment.json
# User wallpaper artwork and videos are not redistributed
/wallpaper/

# UX workspace records contain private paths
/config/projects.json
/config/wallpaper-gallery.json
/config/profiles/user-*.json

/config/profiles/*.json
!/config/profiles/Developer.json
!/config/profiles/Daily.json
!/config/profiles/Gaming.json
!/config/profiles/Focus.json

# Local developer workspace preferences and execution history
/config/developer.json
/config/development-sessions.json
/config/commands.json
/config/smart-automation.json

# Launchpad inventory, private shortcuts and per-user organization
/config/launchpad.json
